# Debian / Ubuntu（glibc）
FROM oven/bun:1.3


# 安装 nginx + tini
RUN apt-get update && \
    apt-get install -y nginx tini && \
    # 清理apt缓存，减小镜像体积
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# # 清理 nginx 默认站点
RUN rm -rf /usr/share/nginx/html/*

# # 拷贝前端
# COPY frontend/dist /usr/share/nginx/html/app
# COPY admin/dist/admin /usr/share/nginx/html/admin

# # 拷贝 nginx 配置，注意是放到的目录位置！！！
# COPY docker/nginx_api.conf /etc/nginx/http.d/default.conf


# 拷贝 Bun API
WORKDIR /app
COPY backend ./bun-api
WORKDIR /app/bun-api
RUN chmod +x /app/bun-api/bin/redka

# RUN bun install
RUN bun install --frozen-lockfile --no-save --verbose


# 启动脚本
COPY docker/run.sh /run.sh
RUN chmod +x /run.sh

# EXPOSE 80


# Debian / Ubuntu 中
ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/run.sh"]


